<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production traffic must be HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- LAN/emulator hosts used for on-device testing before the public API has TLS.
         Remove these entries for the Play Store build. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.29.21</domain>
    </domain-config>
</network-security-config>
