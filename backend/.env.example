# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional paid GSP (leave blank to use Excel upload only)
GSP_BASE_URL=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=

# Optional SMTP for outbound email reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
